{
  "name": "stm-management-app",
  "version": "0.2.0",
  "private": true,
  "description": "Aplikasi pembukuan kas STM (Serikat Tolong Menolong)",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "find src -name '*.test.ts' | xargs node --import tsx --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "build:app": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build && node scripts/salin-standalone.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "native:win": "node scripts/unduh-native.mjs win32-ia32,win32-x64",
    "dist:win": "npm run build:app && npm run native:win && electron-builder --win --ia32 --x64"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^4.15.9",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.545.0",
    "next": "14.2.35",
    "radix-ui": "^1.6.7",
    "react": "18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.6",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "main": "electron/main.js",
  "author": "STM",
  "build": {
    "appId": "id.stm.kas",
    "productName": "Aplikasi Kas STM",
    "copyright": "STM",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "build/icon.ico",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!**/*.node",
          "!**/.next/cache/**"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AplikasiKasSTM-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aplikasi Kas STM",
      "installerLanguages": [
        "id_ID",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "AplikasiKasSTM-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AplikasiKasSTM-Portable-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/pasang-native.js"
  },
  "productName": "Aplikasi Kas STM"
}
